# QA image: Node 22 plus bash and git. Stage "base" is the toolbox (used by --worktree mode);
# stage "qa" adds a git bundle of the committed HEAD and clones it, so no host mount is needed.
FROM node:22-bookworm-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && git config --global --add safe.directory '*' \
 && git config --global user.email qa@example.com \
 && git config --global user.name qa

FROM base AS qa
COPY repo.bundle /tmp/repo.bundle
RUN git clone --quiet /tmp/repo.bundle /work && rm /tmp/repo.bundle
WORKDIR /work
CMD ["bash", "-c", "npm test && bash tests/e2e/install-smoke.sh"]

# LightRAG server configuration. Copy to ~/lightrag/.env and fill in.
# Never commit the filled-in file. See https://github.com/HKUDS/LightRAG for all options.

# --- LLM used for query answering and entity extraction ---
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=<your-provider-key>

# --- Embeddings ---
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=<your-provider-key>

# --- Optional: protect the API. The port is loopback-only, so this is optional.
# LIGHTRAG_API_KEY=<random-string>   # then also set it in ~/.lightrag-local.env
